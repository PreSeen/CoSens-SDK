{
  "name": "cosens-sdk",
  "version": "0.5.4-rsi.6",
  "description": "CoSens TypeScript SDK for local RSI and reusable Recipes",
  "keywords": [
    "cosens",
    "openai",
    "agents",
    "llm",
    "recipes"
  ],
  "homepage": "https://cosens.ai/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PreSeen/CoSens-SDK.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/PreSeen/CoSens-SDK/issues"
  },
  "type": "module",
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rsi": {
      "types": "./dist/rsi/index.d.ts",
      "import": "./dist/rsi/index.js"
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.1",
    "@types/better-sqlite3": "7.6.13",
    "better-sqlite3": "13.0.3",
    "fflate": "0.8.3",
    "langsmith": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
