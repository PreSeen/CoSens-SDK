# One CoSens API Key for CoSens and the model gateway.
# Requires llm.invoke; listing available models also requires llm.models.read.
COSENS_API_KEY=your-cosens-api-key
# The SDK supports the US API.
COSENS_REGION=us
# OpenAI-compatible model gateway for the selected region, read by your application
# when it builds the model client (us: https://llm.cosens.ai/v1). See https://cosens.ai/docs/.
COSENS_MODEL_BASE_URL=
# The application loads this file; SDK reads the process environment.
# Pass the public model ID in code as model=... .
