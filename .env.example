COSENS_RSI_DB=./var/cosens-rsi.sqlite3
COSENS_MEMORY_URL=http://127.0.0.1:18104/memory
COSENS_MEMORY_PROJECT=default
COSENS_MEMORY_INTERNAL_TOKEN=
COSENS_RSI_TOKEN=
COSENS_RSI_ADMIN_TOKEN=
COSENS_RSI_RUNTIME_TRIGGER=manual
COSENS_RSI_IMPROVEMENT_TRIGGER=manual
COSENS_RSI_RECIPE_MEMORY_ENABLED=0
