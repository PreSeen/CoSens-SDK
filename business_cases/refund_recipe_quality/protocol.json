{
  "schema": "refund-recipe-quality-demo-v1",
  "family": "refund-recipe-quality-luna-v1",
  "model": "gpt-6-luna",
  "partitions": {
    "train": [
      "train-allocation",
      "train-approval"
    ],
    "screen": [
      "screen-ledger",
      "screen-policy"
    ],
    "confirm": [
      "confirm-rounding",
      "confirm-whole-order",
      "confirm-signed-scope",
      "confirm-old-policy"
    ]
  },
  "policy": {
    "max_rounds": 1,
    "max_candidates": 2,
    "min_confirm_tasks": 4,
    "min_delta": 0.03,
    "exploration_enabled": false
  },
  "design": "Same models/tools/budgets, frozen per-task snapshots and independent integer/reference checks; only Recipe changes. Train-only model proposer, screen selection, fresh confirm; retain all failures. No candidate route reranking.",
  "train_rollouts": 2,
  "evaluation_revision": "v2-substantive-pending-evidence"
}
