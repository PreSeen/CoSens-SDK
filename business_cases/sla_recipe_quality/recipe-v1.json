{
  "schema": "hierarchical-recipe-1",
  "bindings": {
    "repair": "sla-repair@v1"
  },
  "steps": {
    "sla-repair@v1": {
      "id": "sla-repair",
      "version": "v1",
      "inputs": {
        "task": "text"
      },
      "outputs": {
        "files": "artifacts"
      },
      "body": {
        "preconditions": [],
        "steps": [
          "阅读现有实现与全部公开要求，修复代码，编写自己的回归检查；交付可运行实现与中文说明，并自查接口及业务约束。"
        ],
        "checks": [
          "代码满足公开接口和要求，实际执行自己的测试，交付文件可读。"
        ],
        "recovery": [
          "依据真实错误进行修正并重新检查。"
        ]
      }
    }
  },
  "flow": {
    "id": "sla-code-delivery",
    "version": "v1",
    "checks": [
      "保持公开接口，遵守全部公司工时规则，不硬编码案例答案。"
    ],
    "nodes": [
      {
        "id": "repair",
        "goal": "修复客服SLA工具并自测交付",
        "skill": "repair",
        "inputs": {
          "task": "$task"
        },
        "after": [],
        "max_repairs": 1
      }
    ],
    "final": "repair.files"
  }
}
