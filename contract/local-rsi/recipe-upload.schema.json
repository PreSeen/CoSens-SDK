      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "do",
          "why",
          "when_not"
        ],
        "properties": {
          "when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "do": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "when_not": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    }
