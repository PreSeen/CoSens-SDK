{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "when",
    "when_not",
    "steps",
    "lessons"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "when": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "when_not": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "instruction"
        ],
        "properties": {
          "id": {
            "type": "string",
