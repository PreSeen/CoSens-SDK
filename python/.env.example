# One Friday user API Key for CoSens and the model gateway.
# Requires llm.invoke; listing available models also requires llm.models.read.
COSENS_API_KEY=your-friday-user-api-key
# cn (default) or us; the credential must belong to the selected environment.
COSENS_REGION=cn
# The application loads this file; SDK reads the process environment.
# Pass the public model ID in code as model=... .
