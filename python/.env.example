# 复制为 python/.env，填写真实值；.env 已被 Git 忽略。
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=your-model-name
RSI_API_KEY=your-friday-key

# CoSens 区域：cn（默认）或 us；三个示例均支持。
COSENS_REGION=cn
# SDK 和示例优先使用对应区域 Key；未配置时回退到 RSI_API_KEY。
# RSI_API_KEY_CN=your-cn-friday-key
# RSI_API_KEY_US=your-us-friday-key

# 可选：只影响模型服务；CoSens 网关由 SDK 内部配置。
# OPENAI_BASE_URL=https://your-openai-compatible-service/v1

# 只影响 01_transparent.py；auto 或 disable 都会先召回。
COSENS_MODE=auto
# COSENS_INPUT=请输入你的测试任务
